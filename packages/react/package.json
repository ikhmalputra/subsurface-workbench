{
  "name": "@ikhmalputra/subsurface-react",
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "author": "Ikhmal Putra Manan",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "assets",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    },
    "./gis": {
      "types": "./dist/gis-map.d.ts",
      "import": "./dist/gis-map.js"
    },
    "./gis.css": "./dist/gis.css",
    "./state": {
      "types": "./dist/state.d.ts",
      "import": "./dist/state.js"
    },
    "./2d": {
      "types": "./dist/2d.d.ts",
      "import": "./dist/2d.js"
    },
    "./3d": {
      "types": "./dist/3d.d.ts",
      "import": "./dist/3d.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./viewport": {
      "types": "./dist/viewport.d.ts",
      "import": "./dist/viewport.js"
    },
    "./styles.css": "./dist/styles.css",
    "./three": {
      "types": "./dist/well-scene.d.ts",
      "import": "./dist/well-scene.js"
    },
    "./assembly-three": {
      "types": "./dist/assembly-scene.d.ts",
      "import": "./dist/assembly-scene.js"
    },
    "./trajectory": {
      "types": "./dist/trajectory.d.ts",
      "import": "./dist/trajectory.js"
    },
    "./records": {
      "types": "./dist/records.d.ts",
      "import": "./dist/records.js"
    },
    "./seismic": {
      "types": "./dist/seismic.d.ts",
      "import": "./dist/seismic.js"
    },
    "./assets/*": "./assets/*"
  },
  "dependencies": {
    "@ikhmalputra/subsurface-core": "workspace:*",
    "@types/geojson": "7946.0.16",
    "d3-brush": "3.0.0",
    "d3-scale": "4.0.2",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "lucide-react": "1.52.0",
    "maplibre-gl": "6.14.0",
    "react-zoom-pan-pinch": "4.2.0"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/styles.css dist/styles.css && cp node_modules/maplibre-gl/dist/maplibre-gl.css dist/gis.css && cp ../../LICENSE LICENSE"
  },
  "publishConfig": {
    "access": "public"
  }
}
