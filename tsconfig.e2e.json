{
  // The browser suite had no typecheck and no lint: `pnpm lint` covers apps/demo/src and packages,
  // and no tsconfig included e2e/. A refactor there once dropped an import, which would have been a
  // runtime ReferenceError found only by running the suite — the slowest possible feedback.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["e2e/**/*.ts", "playwright.config.ts"]
}
